# SF10 capacity probe for the LLM-free entity steps (10, 20, 30, 50, 60).
# SF10 = ~10 GB strict CSV = ~2.145M primary movies at the release's
# ~4.66 KB per movie. Entity ratios follow the release export (name 2.4x,
# company 0.09x, keyword 0.109x movies); characters at 8.5x (the release
# exported 7.4x char_name rows); titles 1.3x.
RUN_PROFILE=sf10_entities
N_MOVIES=2145000
START_YEAR=2000
END_YEAR=2050
N_PERSONS=5148000
N_COMPANIES=193000
N_KEYWORDS=234000
N_CHARACTERS=18230000
N_TITLES=2790000
RERANK_BUDGET_MOVIES=5000
KEYWORD_RERANK_BUDGET_MOVIES=5000
FAST_TITLE_TAGLINES=1
