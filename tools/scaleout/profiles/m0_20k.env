# M0 measurement at 20K movies over the release year span (2000-2050), with
# entity counts in the same ratios as the released candidate100k_2000_2050
# profile (persons 2.4x, companies 0.09x, keywords ~0.11x, characters 17x,
# titles 1.3x movies) so the shipped LLM banks and plans are reused.
RUN_PROFILE=m0_20k
N_MOVIES=20000
START_YEAR=2000
END_YEAR=2050
N_PERSONS=48000
N_COMPANIES=1800
N_KEYWORDS=2200
N_CHARACTERS=340000
N_TITLES=26000
RERANK_BUDGET_MOVIES=1000
KEYWORD_RERANK_BUDGET_MOVIES=1000
FAST_TITLE_TAGLINES=1
DATA_SYS_STEP100_SPOOL_ROWS=10000
DATA_SYS_STEP100_GRAPH_CHECKPOINT_MODE=delta
DATA_SYS_ACTOR_VIEW_CACHE_MAX=96
DATA_SYS_CAST_BASE_FOCUS_SIZE_CAP=1800
DATA_SYS_CAST_FOCUS_CAP=1100
