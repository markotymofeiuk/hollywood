# Settings for real runs on the Albert API (DeepSeek V4 Flash). No secrets
# here: the URL, model and key(s) come from the repo-root .env
# (LOCAL_LLM_URL, LOCAL_LLM_MODEL, LOCAL_LLM_API_KEY or
# LOCAL_LLM_API_KEYS=key1,key2,key3).
LLM_PROVIDER=local
# Per-key limits; the limiter keeps 90% headroom (DATA_SYS_LLM_LIMIT_SAFETY).
DATA_SYS_LLM_RPM=50
DATA_SYS_LLM_TPM=256000
# In-flight calls: empty = 80 per key, set by run_sf.sh (one key at 50 req/min
# with ~90 s calls needs ~75). Set DATA_SYS_LLM_CONCURRENCY in .env to override.
DATA_SYS_LLM_CONCURRENCY=${DATA_SYS_LLM_CONCURRENCY:-}
# DeepSeek V4 thinks by default (10x the tokens, 9x the latency).
DATA_SYS_LLM_EXTRA_BODY='{"chat_template_kwargs": {"thinking": false}}'
# Prompt-based JSON; response_format=json_object breaks array prompts.
DATA_SYS_OPENAI_JSON_MODE=prompt
# Long outputs (40 bios = ~5.5K tokens) need more than the 70-90 s defaults.
DATA_SYS_LLM_TIMEOUT_SEC=300
# Keep the post-generation critic prompt inside the 131K context.
DATA_SYS_CRITIC_MAX_SAMPLE=300
# Steps request Gemini model ids by default; send LOCAL_LLM_MODEL instead.
DATA_SYS_LLM_PIN_MODEL=1
